# Keep the build context small and reproducible.
.git
.gitignore
.github

# Node
node_modules/
npm-debug.log*
.npm/
.pnpm-store/

# Bot runtime state — never bake a live store into an image
data/
*.json.log
logs/
*.log

# Python leftovers (the bot is Node-only now; ignored for safety)
__pycache__/
*.py[cod]
.venv/
venv/

# Docs & deploy helpers not needed at runtime
DEPLOY.md
RESEARCH.md
README.md
Dockerfile
.dockerignore
